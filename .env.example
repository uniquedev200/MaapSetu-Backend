# ---- MetriCert backend deployment env (set these on Render, never commit .env) ----
# Supabase PostgreSQL (transaction pooler)
DATABASE_URL=postgresql+psycopg://postgres.XXXX:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Public consumer portal origin (Vercel frontend) so certificate QRs deep-link there
PUBLIC_BASE_URL=https://YOUR-FRONTEND.vercel.app

# Browser origins allowed to call this API
CORS_ORIGINS=["https://YOUR-FRONTEND.vercel.app","http://localhost:5175"]

# Persist certificates/QR/uploads in Supabase Storage (Render disk is ephemeral!)
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=metricert

ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string
SEED_ADMIN_EMAIL=admin@metricert.gov.in
SEED_ADMIN_PASSWORD=admin12345